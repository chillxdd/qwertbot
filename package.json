{
  "name": "sqwertarmybot",
  "version": "1.0.0",
  "private": true,
  "description": "Twitch and YouTube community bot for GeneralQwert",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "check": "find . -name '*.js' -not -path './node_modules/*' -not -path './.git/*' -print0 | xargs -0 -n1 node --check",
    "test": "node --test tests/*.test.js",
    "verify": "npm run check && npm test",
    "postinstall": "node diagnostics/install_streamlist_python_deps.js",
    "prestart": "node diagnostics/install_streamlist_python_deps.js"
  },
  "engines": {
    "node": ">=20 <23"
  },
  "dependencies": {
    "express": "4.22.2",
    "mongoose": "8.24.2",
    "tmi.js": "1.8.5",
    "@grpc/grpc-js": "1.14.4",
    "@grpc/proto-loader": "0.8.1"
  }
}
